APP_HOST=0.0.0.0
APP_PORT=8080
# Каталог файлов логов. Если в него нельзя писать, процесс пишет только в консоль и не падает.
LOG_DIR=logs

PG_ENABLED=true
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=finder
PG_USERNAME=finder
PG_PASSWORD=finder
PG_MIGRATIONS_RUN=true
PG_LOGGING=false
# true — сид категорий и демо-товаров при старте API. Только локально и на dev.
# В проде false: deploy/docker-compose.prod.yml перебивает значение.
PG_SEEDERS_RUN=true
STORAGE_PATH=storage

SWAGGER_ENABLED=true
OPENAPI_FILE=api/openapi.json

CONTRACT_REPO=../../Finder-api-contract

# Администраторы
# Статический токен для HTTP API админки (обязателен в production)
ADMIN_API_TOKEN=your-secret-admin-token-change-me

# Приём досье POST /research/ingest. Не совпадает с ADMIN_API_TOKEN.
RESEARCH_INGEST_TOKEN=change-me-research-ingest-token

# Запуск ресерча. Пустой URL не роняет процесс: заявка остаётся в RESEARCHING, в лог пишется предупреждение.
RESEARCH_TRIGGER_URL=
RESEARCH_TRIGGER_SECRET=change-me-research-trigger-secret
# Куда рутина вернёт досье: ${PUBLIC_BASE_URL}/research/ingest
PUBLIC_BASE_URL=http://localhost:8080
# Сколько раз повторять webhook на 5xx и сетевых ошибках, и пауза перед следующей попыткой (мс, растёт с номером попытки).
RESEARCH_TRIGGER_MAX_ATTEMPTS=3
RESEARCH_TRIGGER_RETRY_DELAY_MS=250
# Прогон без досье старше этого порога помечается STALE. Проверка каждые N минут. 0 выключает таймер.
RESEARCH_STALE_AFTER_MIN=60
RESEARCH_STALE_CHECK_MIN=5
# Очередь ресерча на Postgres. Интервал опроса задач в мс. 0 выключает worker.
RESEARCH_QUEUE_POLL_MS=2000

# Запасной курс, если в досье нет cny_rub или usd_rub. В ответе менеджеру такой слой помечен fallback.
FX_FALLBACK_CNY_RUB=12.3
FX_FALLBACK_USD_RUB=90

# LLM Classification (optional, falls back to pause if not configured)
LLM_API_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_CONFIDENCE_THRESHOLD=0.7
