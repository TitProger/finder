APP_HOST=0.0.0.0
APP_PORT=8080

PG_ENABLED=true
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=finder
PG_USERNAME=finder
PG_PASSWORD=finder
PG_MIGRATIONS_RUN=true
PG_LOGGING=false

SWAGGER_ENABLED=true
OPENAPI_FILE=api/openapi.json

CONTRACT_REPO=../api-contract

# JWT (для обратной совместимости, но статический токен предпочтительнее)
JWT_SECRET=finder-dev-jwt-secret-change-me
JWT_ACCESS_TTL_SEC=3600
JWT_REFRESH_TTL_SEC=1209600
ADMIN_SEED_LOGIN=admin
ADMIN_SEED_PASSWORD=admin
ADMIN_SEED_DISPLAY_NAME="Finder Admin"
ADMIN_SEED_TELEGRAM_USER_ID=

# Администраторы
# Статический токен для HTTP API админки (обязателен в production)
ADMIN_API_TOKEN=your-secret-admin-token-change-me
# Telegram ID админов через запятую (например: 871909427,123456789)
ADMIN_TELEGRAM_IDS=871909427

# Telegram бот
TELEGRAM_BOT_TOKEN=

# Тарифы
# Лимит запросов в день для бесплатного тарифа
FREE_PLAN_DAILY_LIMIT=3

# Приём досье POST /research/ingest. Не совпадает с ADMIN_API_TOKEN.
RESEARCH_INGEST_TOKEN=change-me-research-ingest-token

# LLM Classification (optional, falls back to pause if not configured)
LLM_API_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_CONFIDENCE_THRESHOLD=0.7
