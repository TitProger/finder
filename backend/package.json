{
    "name": "finder-backend",
    "version": "0.0.1",
    "description": "Backend Finder: поиск завода и сравнение цен для менеджера",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "typecheck": "tsc --noEmit -p tsconfig.build.json",
        "format": "prettier --write \"src/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "migration:create": "mikro-orm migration:create",
        "migration:list": "mikro-orm migration:list",
        "migration:up": "mikro-orm migration:up",
        "migration:down": "mikro-orm migration:down",
        "seed": "node scripts/run-seed.mjs",
        "contract:sync": "bash scripts/contract-sync.sh",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage"
    },
    "dependencies": {
        "@fastify/multipart": "^10.1.9",
        "@fastify/static": "^10.1.11",
        "@mikro-orm/core": "^6.5.9",
        "@mikro-orm/migrations": "^6.5.9",
        "@mikro-orm/nestjs": "^6.1.1",
        "@mikro-orm/postgresql": "^6.5.9",
        "@nestjs/common": "^11.1.8",
        "@nestjs/core": "^11.1.8",
        "@nestjs/platform-fastify": "^11.1.8",
        "@nestjs/swagger": "^11.2.1",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "dotenv": "^17.2.3",
        "fastify": "^5.6.1",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "winston": "^3.11.0",
        "winston-daily-rotate-file": "^5.0.0",
        "yaml": "^1.10.3"
    },
    "devDependencies": {
        "@mikro-orm/cli": "^6.5.9",
        "@nestjs/cli": "^11.0.10",
        "@redocly/cli": "^1.34.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.10.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^17.11.0",
        "jest": "^30.4.2",
        "openapi-typescript": "^7.6.1",
        "prettier": "^3.6.2",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0"
    },
    "mikro-orm": {
        "useTsNode": true,
        "configPaths": [
            "./src/common/config/mikro-orm/mikro-orm.config.ts",
            "./dist/src/common/config/mikro-orm/mikro-orm.config.js"
        ]
    }
}
