  ADMIN
  CLIENT
}

Enum category_status {
  ACTIVE
  ARCHIVED
}

Enum question_answer_type {
  TEXT
  NUMBER
  BOOLEAN
  SINGLE_CHOICE
  MULTI_CHOICE
}

Enum site_role {
  FACTORY_CONTACT
  CHINA_OPEN_PRICE
  RUSSIA_RETAIL
  RUSSIA_WHOLESALE
}

Enum inquiry_status {
  DRAFT
  AWAITING_CATEGORY
  COLLECTING_ANSWERS
  QUEUED_RESEARCH
  SERVED_FROM_DATABASE
  RESEARCHING
  DOSSIER_WITH_ADMIN
