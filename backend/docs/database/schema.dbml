// Агрегированная схема Finder для превью (dbdiagram / VS Code).
// Куски также лежат в enums/ и tables/.
// Имена английские. Пояснения к полям — русские. ON DELETE указан у каждой FK-колонки.

Enum user_role {
  ADMIN
  CLIENT
}

Enum category_status {
  ACTIVE
  ARCHIVED
}

Enum question_answer_type {
  TEXT
  NUMBER
  BOOLEAN
  SINGLE_CHOICE
  MULTI_CHOICE
}

Enum site_role {
  FACTORY_CONTACT
  CHINA_OPEN_PRICE
  RUSSIA_RETAIL
  RUSSIA_WHOLESALE
}

Enum inquiry_status {
  DRAFT
  AWAITING_CATEGORY
  COLLECTING_ANSWERS
  SERVED_FROM_DATABASE
  RESEARCHING
  DOSSIER_WITH_ADMIN
  CLOSED
}

Enum supplier_role {
  DIRECT_FACTORY
  FACTORY_WITH_EXPORTER
  TRADER
  UNVERIFIED
  DEALER_OR_LIST_PRICE
}

Enum market_price_layer {
  RUSSIA_RETAIL
  RUSSIA_WHOLESALE
  CHINA_OPEN
}

Enum company_registry_status {
  ACTIVE
  REVOKED
  UNKNOWN
  OTHER
}

Enum research_run_status {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

Enum contact_channel {
  PHONE
  EMAIL
  WECHAT
  TELEGRAM
  OTHER
}

Table app_user {
  id uuid [pk, not null, note: 'Первичный ключ пользователя.']
  role user_role [not null, note: 'ADMIN — учётка JWT и кнопки бота; CLIENT — вход по Telegram user id.']
  telegram_user_id bigint [null, unique, note: 'Telegram user id. Обязателен при role=CLIENT. У ADMIN заполняется, если он работает в боте: бот читает роль этой строки. Unique.']
  login varchar(100) [null, unique, note: 'Логин админа для JWT. Обязателен при role=ADMIN. У CLIENT пусто. Unique.']
  password_hash varchar(255) [null, note: 'Хэш пароля админа. Обязателен при role=ADMIN. У CLIENT пусто. Регистрации нет — сид в БД.']
  display_name varchar(255) [null, note: 'Отображаемое имя для админки и логов.']
  is_active boolean [not null, default: true, note: 'Выключенный пользователь не входит.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда создана запись.']
  updated_at timestamptz [default: `now()`, note: 'Когда последний раз меняли запись.']

  Note: 'Роли MVP: ADMIN и CLIENT. Отдельной регистрации нет. Бот узнаёт человека по telegram_user_id и отдаёт админские кнопки только при role=ADMIN. Partial: telegram_user_id NOT NULL при CLIENT; login и password_hash NOT NULL при ADMIN.'
}

Table category {
  id uuid [pk, not null, note: 'Первичный ключ категории.']
  name varchar(255) [not null, unique, note: 'Имя категории для админа и бота. Unique.']
  description text [not null, note: 'Текст для эмбеддинга и подсказок классификатору. Без цены.']
  status category_status [not null, default: 'ACTIVE', note: 'ACTIVE участвует в классификации; ARCHIVED скрыта.']
  embedding vector [null, note: 'Вектор description. Размерность фиксируется миграцией под модель. Цену не класть.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда создана категория.']
  updated_at timestamptz [default: `now()`, note: 'Когда последний раз меняли категорию.']

  Note: 'Справочник категорий. Семь стартовых — данные сида, не схема. Вектор только от текста описания.'
}

Table category_phrase {
  id uuid [pk, not null, note: 'Первичный ключ фразы.']
  category_id uuid [not null, ref: > category.id, note: 'ON DELETE CASCADE. Категория, к которой относится фраза.']
  phrase text [not null, note: 'Пример или синоним клиента. Точное совпадение сразу выбирает категорию.']
  embedding vector [null, note: 'Вектор phrase для похожести. Размерность как у category.embedding. Цену не класть.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда фразу добавили.']
  updated_at timestamptz [default: `now()`, note: 'Когда фразу правили.']

  indexes {
    (category_id, phrase) [unique, note: 'Одна и та же фраза не дублируется в категории.']
  }

  Note: 'Примеры и синонимы категории. Админ дописывает фразу клиента после ручного назначения.'
}

Table question_pack {
  id uuid [pk, not null, note: 'Первичный ключ пакета вопросов.']
  category_id uuid [not null, ref: > category.id, note: 'ON DELETE CASCADE. Категория пакета.']
  code varchar(64) [not null, note: 'Стабильный код пакета внутри категории, например WORKWEAR.']
  title varchar(255) [not null, note: 'Человекочитаемое имя пакета для админа.']
  description text [null, note: 'Когда включать пакет; для матчинга внутри уже выбранной категории.']
  sort_order int [not null, default: 0, note: 'Порядок перебора пакетов при уточнении.']
  is_active boolean [not null, default: true, note: 'Выключенный пакет не предлагается.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда пакет создан.']
  updated_at timestamptz [default: `now()`, note: 'Когда пакет меняли.']

  indexes {
    (category_id, code) [unique, note: 'Код пакета уникален в категории.']
  }

  Note: 'Уточнение внутри категории (спецодежда внутри одежды). Сомнение между пакетами админу не уходит.'
}

Table category_question {
  id uuid [pk, not null, note: 'Первичный ключ вопроса.']
  category_id uuid [not null, ref: > category.id, note: 'ON DELETE CASCADE. Категория вопроса.']
  question_pack_id uuid [null, ref: > question_pack.id, note: 'ON DELETE CASCADE. Пакет уточнения. NULL = базовый вопрос категории.']
  prompt text [not null, note: 'Текст вопроса клиенту в Telegram.']
  answer_type question_answer_type [not null, note: 'Как принимать и хранить ответ.']
  choices jsonb [null, note: 'Варианты для SINGLE_CHOICE / MULTI_CHOICE. Иначе NULL.']
  is_required boolean [not null, default: true, note: 'Обязательный ответ до продолжения брифа.']
  sort_order int [not null, default: 0, note: 'Порядок показа вопросов в пакете или базе.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда вопрос создан.']
  updated_at timestamptz [default: `now()`, note: 'Когда вопрос меняли.']

  indexes {
    (category_id, question_pack_id, sort_order)
  }

  Note: 'Базовые вопросы: question_pack_id IS NULL. Вопросы пакета: pack заполнен. При сборе — база + выбранный pack.'
}

Table category_site {
  id uuid [pk, not null, note: 'Первичный ключ площадки категории.']
  category_id uuid [not null, ref: > category.id, note: 'ON DELETE CASCADE. Категория, для которой площадка.']
  site_role site_role [not null, note: 'Роль слоя: контакт завода, открытая цена Китая, розница/опт РФ.']
  name varchar(255) [not null, note: 'Имя площадки для админа и скилла, например 1688.']
  base_url varchar(2048) [null, note: 'Базовый URL площадки, если фиксирован.']
  priority int [not null, default: 100, note: 'Порядок обхода. Меньше — раньше. Низкий приоритет в проход не берётся.']
  requires_login boolean [not null, default: false, note: 'Нужен ли заранее залогиненный браузерный профиль.']
  query_template text [null, note: 'Шаблон запроса на языке источника с плейсхолдерами брифа.']
  exclude_note text [null, note: 'Когда площадку не использовать для части товаров этой категории.']
  is_active boolean [not null, default: true, note: 'Выключенная площадка не уходит в ресерч.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда площадку добавили.']
  updated_at timestamptz [default: `now()`, note: 'Когда площадку правили.']

  indexes {
    (category_id, site_role, priority)
  }

  Note: 'Площадки категории по ролям. Ресерч открывает только этот список, чужие сайты сам не добавляет.'
}

Table canonical_product {
  id uuid [pk, not null, note: 'Первичный ключ канонического товара.']
  category_id uuid [not null, ref: > category.id, note: 'ON DELETE RESTRICT. Категория товара. Поиск карточек только внутри неё.']
  name_ru varchar(512) [not null, note: 'Нормализованное русское имя товара.']
  name_zh varchar(512) [null, note: 'Нормализованное китайское имя, если есть.']
  attributes jsonb [null, note: 'Ключевые признаки из вопросов категории (ткань, год, комплектация).']
  embedding vector [null, note: 'Вектор текстового описания товара. Без цены. Размерность как у category.embedding.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда товар завели.']
  updated_at timestamptz [default: `now()`, note: 'Когда товар меняли.']

  indexes {
    (category_id, name_ru)
  }

  Note: 'Канонический товар внутри категории. На него вешаются офферы и оптимальные карточки.'
}

Table company {
  id uuid [pk, not null, note: 'Первичный ключ компании.']
  legal_name_zh varchar(512) [not null, note: 'Китайское юридическое имя из реестра или карточки.']
  unified_social_credit_code varchar(32) [null, unique, note: 'Единый социальный кредитный код. Unique, если известен.']
  registry_status company_registry_status [not null, default: 'UNKNOWN', note: 'Статус в реестре на момент съёма.']
  address text [null, note: 'Адрес компании из реестра или карточки.']
  business_scope text [null, note: 'Сфера деятельности; помогает отличить завод от торговца.']
  insured_employee_count int [null, note: 'Число застрахованных сотрудников, если снято.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда компанию записали.']
  updated_at timestamptz [default: `now()`, note: 'Когда карточку компании меняли.']

  Note: 'Китайская (или иная) компания из ресерча. Реестр включается, когда найдено юридическое лицо.'
}

Table storefront {
  id uuid [pk, not null, note: 'Первичный ключ витрины продавца.']
  company_id uuid [null, ref: > company.id, note: 'ON DELETE SET NULL. Компания витрины, если известна.']
  platform_name varchar(128) [not null, note: 'Площадка витрины: 1688, Alibaba, Авто.ру и т.п.']
  seller_external_id varchar(255) [null, note: 'Id продавца на площадке.']
  storefront_url varchar(2048) [not null, note: 'Ссылка на витрину или магазин.']
  factory_labels jsonb [null, note: 'Метки «фабрика / торговец» с площадки, как снято.']
  city varchar(255) [null, note: 'Город продавца или склада.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда витрину записали.']
  updated_at timestamptz [default: `now()`, note: 'Когда витрину меняли.']

  indexes {
    (platform_name, seller_external_id) [unique, note: 'Один seller id на площадке — одна витрина. Partial: где seller_external_id NOT NULL.']
  }

  Note: 'Витрина продавца на конкретной площадке. Может жить без company, пока юрлицо не сверено.'
}

Table inquiry {
  id uuid [pk, not null, note: 'Первичный ключ заявки.']
  client_user_id uuid [not null, ref: > app_user.id, note: 'ON DELETE RESTRICT. Клиент Telegram, от которого заявка.']
  status inquiry_status [not null, default: 'DRAFT', note: 'Черновик → ожидание категории → сбор ответов → из базы / ресерч → досье у админа → закрыто.']
  raw_text text [not null, note: 'Свободный текст клиента из Telegram.']
  photo_urls text[] [not null, default: `'{}'`, note: 'Telegram file_id фото клиента. Пустой массив, если фото нет. Бот пересылает их админу по этому id, это не публичная ссылка.']
  category_id uuid [null, ref: > category.id, note: 'ON DELETE SET NULL. Назначенная категория. NULL до выбора или при сомнении.']
  question_pack_id uuid [null, ref: > question_pack.id, note: 'ON DELETE SET NULL. Уточняющий пакет внутри категории. NULL = только база.']
  classification_scores jsonb [null, note: 'Топ категорий с оценками для карточки сомнения админу.']
  is_paused boolean [not null, default: false, note: 'Пауза ресерча: сомнение по категории или отказ клиента. Пока true — ресерч не стартует.']
  pause_reason text [null, note: 'Почему на паузе: сомнение классификатора, отказ клиента от категории и т.п.']
  assigned_by_user_id uuid [null, ref: > app_user.id, note: 'ON DELETE SET NULL. Админ, назначивший категорию вручную.']
  optimal_card_id uuid [null, note: 'ON DELETE SET NULL. FK → optimal_card.id. Живая карточка при status=SERVED_FROM_DATABASE.']
  closed_at timestamptz [null, note: 'Когда заявку закрыли.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда заявка создана.']
  updated_at timestamptz [default: `now()`, note: 'Когда заявку меняли.']

  indexes {
    (client_user_id, created_at)
    (status, created_at)
    category_id
  }

  Note: 'Заявка клиента. Коммерческое предложение бот не пишет. Логистика и ответ клиенту — человек.'
}

Table inquiry_answer {
  id uuid [pk, not null, note: 'Первичный ключ ответа.']
  inquiry_id uuid [not null, ref: > inquiry.id, note: 'ON DELETE CASCADE. Заявка, к которой ответ.']
  category_question_id uuid [not null, ref: > category_question.id, note: 'ON DELETE RESTRICT. Вопрос категории или пакета.']
  value_text text [null, note: 'Ответ строкой для TEXT / NUMBER / BOOLEAN / одного выбора.']
  value_json jsonb [null, note: 'Ответ структурой для MULTI_CHOICE и сложных значений.']
  answered_at timestamptz [not null, default: `now()`, note: 'Когда клиент ответил.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда строку ответа создали.']
  updated_at timestamptz [default: `now()`, note: 'Когда ответ правили.']

  indexes {
    (inquiry_id, category_question_id) [unique, note: 'Один ответ на вопрос в заявке.']
  }

  Note: 'Ответы клиента на вопросы выбранной категории и пакета. Питают бриф ресерча и матч оптимальной карточки.'
}

Table research_run {
  id uuid [pk, not null, note: 'Первичный ключ прогона ресерча.']
  inquiry_id uuid [not null, ref: > inquiry.id, note: 'ON DELETE CASCADE. Заявка, для которой запущен прогон.']
  source varchar(128) [not null, note: 'Кто исполняет прогон: grok_bot, ручной импорт JSON и т.п.']
  status research_run_status [not null, default: 'PENDING', note: 'Статус внешнего или внутреннего прогона.']
  external_run_url varchar(2048) [null, note: 'Ссылка на прогон во внешней системе, если есть.']
  failure_reason text [null, note: 'Причина срыва при status=FAILED.']
  started_at timestamptz [null, note: 'Когда прогон реально стартовал.']
  finished_at timestamptz [null, note: 'Когда прогон завершился или сорвался.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда запись прогона создали.']
  updated_at timestamptz [default: `now()`, note: 'Когда прогон обновляли.']

  indexes {
    (inquiry_id, created_at)
    status
  }

  Note: 'Один прогон ресерча по заявке. Площадки берёт из category_site выбранной категории.'
}

Table offer {
  id uuid [pk, not null, note: 'Первичный ключ предложения.']
  research_run_id uuid [null, ref: > research_run.id, note: 'ON DELETE SET NULL. Прогон, в котором сняли оффер.']
  canonical_product_id uuid [null, ref: > canonical_product.id, note: 'ON DELETE SET NULL. Канонический товар, если уже сопоставили.']
  company_id uuid [null, ref: > company.id, note: 'ON DELETE SET NULL. Компания-поставщик, если известна.']
  storefront_id uuid [null, ref: > storefront.id, note: 'ON DELETE SET NULL. Витрина, с которой сняли.']
  category_site_id uuid [null, ref: > category_site.id, note: 'ON DELETE SET NULL. Площадка категории, по которой шли.']
  source_url varchar(2048) [not null, note: 'URL страницы-источника. Без него оффер невалиден.']
  price numeric [null, note: 'Цена со страницы. Может быть NULL, если на странице только контакт.']
  currency varchar(3) [null, note: 'ISO-код валюты цены, если цена есть.']
  volume_tier text [null, note: 'Ступень объёма / комплектация, к которой относится цена.']
  moq numeric [null, note: 'Минимальная партия (MOQ), если указана.']
  quote_text text [null, note: 'Цитата со страницы про цену или условия.']
  supplier_role supplier_role [not null, default: 'UNVERIFIED', note: 'Роль поставщика после сверки правил.']
  captured_at timestamptz [not null, note: 'Когда цену/контакт сняли со страницы.']
  expires_at timestamptz [null, note: 'Срок годности заводской цены/контакта (ориентир 30 дней от captured_at).']
  created_at timestamptz [not null, default: `now()`, note: 'Когда строку оффера создали.']
  updated_at timestamptz [default: `now()`, note: 'Когда оффер правили.']

  indexes {
    source_url
    (canonical_product_id, captured_at)
    research_run_id
  }

  Note: 'Предложение с обязательным source_url. Контакт и цена без адреса страницы не принимаются.'
}

Table market_snapshot {
  id uuid [pk, not null, note: 'Первичный ключ снимка слоя цен.']
  research_run_id uuid [null, ref: > research_run.id, note: 'ON DELETE SET NULL. Прогон, из которого собрали слой.']
  inquiry_id uuid [null, ref: > inquiry.id, note: 'ON DELETE SET NULL. Заявка снимка, если известна.']
  canonical_product_id uuid [null, ref: > canonical_product.id, note: 'ON DELETE SET NULL. Товар, по которому посчитан слой.']
  layer market_price_layer [not null, note: 'Слой: розница РФ, опт РФ или открытая цена Китая.']
  source varchar(255) [not null, note: 'Откуда медиана: список площадок или описание выборки.']
  median_price numeric [null, note: 'Медиана цен слоя. Не кладётся в вектор.']
  currency varchar(3) [null, note: 'Валюта медианы и разброса.']
  spread_low numeric [null, note: 'Нижняя граница разброса цен слоя.']
  spread_high numeric [null, note: 'Верхняя граница разброса цен слоя.']
  sample_points jsonb [null, note: 'Примеры внутри снимка: цена, url, краткая метка источника.']
  captured_at timestamptz [not null, note: 'Дата съёма слоя.']
  expires_at timestamptz [not null, note: 'Срок годности снимка (ориентир 14 дней от captured_at).']
  created_at timestamptz [not null, default: `now()`, note: 'Когда снимок записали.']
  updated_at timestamptz [default: `now()`, note: 'Когда снимок правили.']

  indexes {
    (canonical_product_id, layer, captured_at)
    research_run_id
  }

  Note: 'Снимок одного ценового слоя. Слои не склеиваются в одну цифру. Примеры — в sample_points.'
}

Table optimal_card {
  id uuid [pk, not null, note: 'Первичный ключ оптимальной карточки.']
  category_id uuid [not null, ref: > category.id, note: 'ON DELETE RESTRICT. Категория карточки; поиск только внутри неё.']
  canonical_product_id uuid [not null, ref: > canonical_product.id, note: 'ON DELETE RESTRICT. Товар карточки.']
  qty_min numeric [not null, note: 'Нижняя граница диапазона количества, для которого карточка жива.']
  qty_max numeric [not null, note: 'Верхняя граница диапазона количества.']
  quantity_question_id uuid [not null, ref: > category_question.id, note: 'ON DELETE RESTRICT. Обязательный вопрос NUMBER: его ответ — объём и должен попасть в qty_min…qty_max.']
  is_live boolean [not null, default: false, note: 'Живая только после явного флага админа. По умолчанию false.']
  offer_id uuid [null, ref: > offer.id, note: 'ON DELETE SET NULL. Оффер-основание, если карточка из ресерча.']
  company_id uuid [null, ref: > company.id, note: 'ON DELETE SET NULL. Компания лучшего варианта.']
  storefront_id uuid [null, ref: > storefront.id, note: 'ON DELETE SET NULL. Витрина лучшего варианта.']
  price numeric [null, note: 'Цена лучшего варианта, как утвердил админ.']
  currency varchar(3) [null, note: 'Валюта цены карточки.']
  contact_value varchar(512) [null, note: 'Контакт: телефон, почта, WeChat и т.п.']
  contact_channel contact_channel [null, note: 'Канал контакта.']
  contact_url varchar(2048) [null, note: 'URL страницы контакта. Пусто, если admin_entered.']
  contact_admin_entered boolean [not null, default: false, note: 'true — контакт вписан админом без url.']
  contact_entered_at timestamptz [null, note: 'Когда контакт зафиксировали или вписали.']
  product_attributes jsonb [null, note: 'Обязательные ответы кроме объёма. Ключ — id вопроса, значение — как его сохраняет заявка.']
  reason_note text [null, note: 'Почему админ выбрал этот вариант.']
  marked_live_by_user_id uuid [null, ref: > app_user.id, note: 'ON DELETE SET NULL. Админ, включивший is_live.']
  marked_live_at timestamptz [null, note: 'Когда карточку сделали живой.']
  expires_at timestamptz [null, note: 'Срок жизни карточки/контакта (ориентир 30 дней).']
  created_at timestamptz [not null, default: `now()`, note: 'Когда карточку создали.']
  updated_at timestamptz [default: `now()`, note: 'Когда карточку правили.']

  indexes {
    (canonical_product_id, qty_min, qty_max, is_live)
    quantity_question_id
  }

  Note: 'Partial unique: одна живая (is_live=true) на (canonical_product_id, qty_min, qty_max). Повторная живая снимает флаг, строка остаётся. Поиск: та же категория, те же обязательные ответы, объём внутри диапазона, expires_at в будущем.'
}

Table manual_economics {
  id uuid [pk, not null, note: 'Первичный ключ ручной экономики.']
  inquiry_id uuid [not null, unique, ref: > inquiry.id, note: 'ON DELETE CASCADE. Заявка, для которой считают экономику. 1:1.']
  optimal_card_id uuid [null, ref: > optimal_card.id, note: 'ON DELETE SET NULL. Карточка, от которой считают, если есть.']
  fx_rate numeric [null, note: 'Курс пересчёта, который вписал человек.']
  logistics_cost numeric [null, note: 'Логистика вручную.']
  duty_cost numeric [null, note: 'Пошлина вручную.']
  markup_amount numeric [null, note: 'Наценка в деньгах.']
  client_price numeric [null, note: 'Итоговая цена клиенту, которую посчитал человек.']
  currency varchar(3) [null, note: 'Валюта полей экономики, обычно RUB.']
  note text [null, note: 'Пояснение менеджера к расчёту.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда экономику завели.']
  updated_at timestamptz [default: `now()`, note: 'Когда экономику меняли.']

  Note: 'Ручная экономика по заявке. Пустые поля = вердикта «выгодно» ещё нет. Авто-КП нет.'
}

// Циклическая связь inquiry → optimal_card (объявлена после обеих таблиц).
Ref: inquiry.optimal_card_id > optimal_card.id [delete: set null]
