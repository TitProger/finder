// Куски заявок. Агрегат — ../schema.dbml.

Table inquiry {
  id uuid [pk, not null, note: 'Первичный ключ заявки.']
  client_user_id uuid [not null, ref: > app_user.id, note: 'ON DELETE RESTRICT. Клиент Telegram, от которого заявка.']
  status inquiry_status [not null, default: 'DRAFT', note: 'Черновик → ожидание категории → сбор ответов → из базы / ресерч → досье у админа → закрыто.']
  raw_text text [not null, note: 'Свободный текст клиента из Telegram.']
  photo_urls text[] [not null, default: `'{}'`, note: 'Telegram file_id фото клиента. Пустой массив, если фото нет. Бот пересылает их админу по этому id, это не публичная ссылка.']
  category_id uuid [null, ref: > category.id, note: 'ON DELETE SET NULL. Назначенная категория. NULL до выбора или при сомнении.']
  question_pack_id uuid [null, ref: > question_pack.id, note: 'ON DELETE SET NULL. Уточняющий пакет внутри категории. NULL = только база.']
  classification_scores jsonb [null, note: 'Топ категорий с оценками для карточки сомнения админу.']
  is_paused boolean [not null, default: false, note: 'Пауза ресерча: сомнение по категории или отказ клиента. Пока true — ресерч не стартует.']
  pause_reason text [null, note: 'Почему на паузе: сомнение классификатора, отказ клиента от категории и т.п.']
  assigned_by_user_id uuid [null, ref: > app_user.id, note: 'ON DELETE SET NULL. Админ, назначивший категорию вручную.']
  optimal_card_id uuid [null, note: 'ON DELETE SET NULL. FK → optimal_card.id. Живая карточка при status=SERVED_FROM_DATABASE.']
  closed_at timestamptz [null, note: 'Когда заявку закрыли.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда заявка создана.']
  updated_at timestamptz [default: `now()`, note: 'Когда заявку меняли.']

  indexes {
    (client_user_id, created_at)
    (status, created_at)
    category_id
  }

  Note: 'Заявка клиента. Коммерческое предложение бот не пишет. Логистика и ответ клиенту — человек.'
}

Table inquiry_answer {
  id uuid [pk, not null, note: 'Первичный ключ ответа.']
  inquiry_id uuid [not null, ref: > inquiry.id, note: 'ON DELETE CASCADE. Заявка, к которой ответ.']
  category_question_id uuid [not null, ref: > category_question.id, note: 'ON DELETE RESTRICT. Вопрос категории или пакета.']
  value_text text [null, note: 'Ответ строкой для TEXT / NUMBER / BOOLEAN / одного выбора.']
  value_json jsonb [null, note: 'Ответ структурой для MULTI_CHOICE и сложных значений.']
  answered_at timestamptz [not null, default: `now()`, note: 'Когда клиент ответил.']
  created_at timestamptz [not null, default: `now()`, note: 'Когда строку ответа создали.']
  updated_at timestamptz [default: `now()`, note: 'Когда ответ правили.']

  indexes {
    (inquiry_id, category_question_id) [unique, note: 'Один ответ на вопрос в заявке.']
  }

  Note: 'Ответы клиента на вопросы выбранной категории и пакета. Питают бриф ресерча и матч оптимальной карточки.'
}
